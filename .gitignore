# Auto-placer arm script — contains the HR relay token. Never commit.
# Use arm.bat.example as the template; copy to arm.bat and fill in.
arm.bat
data/queue_placer/

# ── Training/calibration outputs — Beelink is the source of truth ──
# The Beelink retrains locally via weekly_retrain.bat. Committing dev-box
# copies would overwrite Beelink-fresh models on next `git pull`. Initial
# Beelink deploy still robocopies data/ per docs/DEPLOY_TO_BEELINK.md.
#
# data/models/ was untracked with `git rm --cached` in the same commit
# that added it here. On the Beelink's next `git pull`, that operation
# will delete the tracked files from the working tree — back up
# data/models/ first (robocopy data\models data\models.backup /E /Z) so
# a scheduled retrain gap doesn't leave the picker model-less.
data/models/
*.pkl
data/*/*_gbm/
data/soccer/*/v31_brier.json
data/*_calibration.json
data/*_constants.json
data/*/*_calibration.json
data/*/*_constants.json
data/state_mc_*.json
data/blend_calibration.json
data/closing_line_weights.json
data/edge_floors.json
data/prop_shrinkage.json
data/stacker_weights.json
data/tennis_hr_cache.json
data/hardrock_sports_query.json
